{
  "name": "assistant-agent",
  "description": "Conversational front door to the Life Command Centre, with full feature parity with the web app: answers questions about commitments, and can create/edit/classify/sync commitments and Gmail drafts via typed tools.",
  "instruction": {
    "$file": "instruction.md"
  },
  "toolsets": [
    "POD"
  ],
  "visibility": "POD",
  "agent_runtime": {
    "profile_id": "system:lemma", "model_name": "deepseek-chat"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "commitments",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "function",
        "resource_name": "create_new_gmail_draft",
        "permission_ids": [
          "function.read",
          "function.execute"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "gmail",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "google_calendar",
        "permission_ids": [
          "connector.use"
        ]
      },
